/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/serviceworker.js
  Cache-Control: no-cache, no-store, must-revalidate

/kill-switch-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/icon-192.png
  Cache-Control: public, max-age=31536000

/icon-512.png
  Cache-Control: public, max-age=31536000

/icon-maskable-512.png
  Cache-Control: public, max-age=31536000

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000

/favicon.png
  Cache-Control: public, max-age=31536000

/img/*
  Cache-Control: public, max-age=31536000
